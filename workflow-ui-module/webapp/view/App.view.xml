<mvc:View
    controllerName="app.workflowuimodule.controller.App"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <App id="app">

        <pages>

            <Page
                id="mainPage"
                title="Employee Transfer Request">

                <content>

                    <uxap:ObjectPageLayout
                        id="ObjectPageLayout"
                        upperCaseAnchorBar="false"
                        showTitleInHeaderContent="false"
                        useTwoColumnsForLargeScreen="true">

                        <!-- ================================================= -->
                        <!-- HEADER TITLE -->
                        <!-- ================================================= -->

                        <uxap:headerTitle>

                            <uxap:ObjectPageHeader
                                id="headerForTransfer"
                                objectTitle="{= ${context>/TransferRequestID} + ' – Employee Transfer Request' }"
                                objectSubtitle="{= ${context>/EmployeeName} + ' – ' + ${context>/EmployeeID} + ' – ' + ${context>/Designation} + ' – ' + ${context>/Department} }"
                                showMarkers="true"
                                markFavorite="true"/>

                        </uxap:headerTitle>


                        <!-- ================================================= -->
                        <!-- SECTIONS -->
                        <!-- ================================================= -->

                        <uxap:sections>


                            <!-- ================================================= -->
                            <!-- TRANSFER REQUEST DETAILS -->
                            <!-- ================================================= -->

                            <uxap:ObjectPageSection
                                id="transferRequestSection"
                                title="Transfer Request Details"
                                titleUppercase="false">

                                <uxap:subSections>

                                    <uxap:ObjectPageSubSection
                                        id="transferRequestSubSection"
                                        title="Employee and Request Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <layout:Grid
                                                defaultSpan="XL4 L4 M6 S12"
                                                hSpacing="1"
                                                vSpacing="1"
                                                width="100%">

                                                <!-- Transfer Request ID -->

                                                <ObjectAttribute
                                                    title="Transfer Request ID"
                                                    text="{context>/TransferRequestID}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Employee ID -->

                                                <ObjectAttribute
                                                    title="Employee ID"
                                                    text="{context>/EmployeeID}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Employee Name -->

                                                <ObjectAttribute
                                                    title="Employee Name"
                                                    text="{context>/EmployeeName}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Department -->

                                                <ObjectAttribute
                                                    title="Department"
                                                    text="{context>/Department}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Designation -->

                                                <ObjectAttribute
                                                    title="Designation"
                                                    text="{context>/Designation}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Requested By -->

                                                <ObjectAttribute
                                                    title="Requested By"
                                                    text="{context>/RequestedBy}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Trade -->

                                                <ObjectAttribute
                                                    title="Required Trade"
                                                    text="{context>/RequiredTrade}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Trade -->

                                                <ObjectAttribute
                                                    title="Relieving Trade"
                                                    text="{context>/RelievingTrade}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Site -->

                                                <ObjectAttribute
                                                    title="Required Site"
                                                    text="{context>/RequiredSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Site -->

                                                <ObjectAttribute
                                                    title="Relieving Site"
                                                    text="{context>/RelievingSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Budgeted -->

                                                <ObjectAttribute
                                                    title="Budgeted"
                                                    text="{context>/Budgeted}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Additional Details -->

                                                <ObjectAttribute
                                                    title="Additional Details"
                                                    text="{context>/AdditionalDetails}"
                                                    class="sapUiTinyMarginBottom"/>

                                            </layout:Grid>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>

                                </uxap:subSections>

                            </uxap:ObjectPageSection>


                            <!-- ================================================= -->
                            <!-- FINAL APPROVAL -->
                            <!-- ================================================= -->

                            <uxap:ObjectPageSection
                                id="finalApprovalSection"
                                title="Final Approval in SAP"
                                titleUppercase="false">

                                <uxap:subSections>


                                    <!-- ================================================= -->
                                    <!-- REQUEST INFORMATION -->
                                    <!-- ================================================= -->

                                    <uxap:ObjectPageSubSection
                                        id="requestInformationSubSection"
                                        title="Request Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <layout:Grid
                                                defaultSpan="XL4 L4 M6 S12"
                                                hSpacing="1"
                                                vSpacing="1"
                                                width="100%">

                                                <!-- Request Type -->

                                                <ObjectAttribute
                                                    title="Request Type"
                                                    text="{context>/RequestType}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Request Status -->

                                                <ObjectAttribute
                                                    title="Request Status"
                                                    text="{context>/RequestStatus}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Requested By -->

                                                <ObjectAttribute
                                                    title="Requested By"
                                                    text="{context>/RequestedBy}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Requested Date -->

                                                <ObjectAttribute
                                                    title="Requested Date"
                                                    text="{context>/RequestedDate}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Department -->

                                                <ObjectAttribute
                                                    title="Department"
                                                    text="{context>/Department}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Site -->

                                                <ObjectAttribute
                                                    title="Required Site"
                                                    text="{context>/RequiredSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Site -->

                                                <ObjectAttribute
                                                    title="Relieving Site"
                                                    text="{context>/RelievingSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Trade -->

                                                <ObjectAttribute
                                                    title="Required Trade"
                                                    text="{context>/RequiredTrade}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Trade -->

                                                <ObjectAttribute
                                                    title="Relieving Trade"
                                                    text="{context>/RelievingTrade}"
                                                    class="sapUiTinyMarginBottom"/>

                                            </layout:Grid>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>


                                    <!-- ================================================= -->
                                    <!-- ALLOCATION AND COST -->
                                    <!-- ================================================= -->

                                    <uxap:ObjectPageSubSection
                                        id="allocationSubSection"
                                        title="Allocation and Cost Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <layout:Grid
                                                defaultSpan="XL4 L4 M6 S12"
                                                hSpacing="1"
                                                vSpacing="1"
                                                width="100%">

                                                <!-- Allotted Number -->

                                                <ObjectAttribute
                                                    title="Allotted Number"
                                                    text="{context>/AllottedNumber}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Active Available -->

                                                <ObjectAttribute
                                                    title="Active Available"
                                                    text="{context>/ActiveAvailable}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Cost Centre -->

                                                <ObjectAttribute
                                                    title="Required Cost Centre"
                                                    text="{context>/RequiredCostCentre}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Budgeted -->

                                                <ObjectAttribute
                                                    title="Budgeted"
                                                    text="{context>/Budgeted}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Additional Details -->

                                                <ObjectAttribute
                                                    title="Additional Details"
                                                    text="{context>/AdditionalDetails}"
                                                    class="sapUiTinyMarginBottom"/>

                                            </layout:Grid>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>


                                    <!-- ================================================= -->
                                    <!-- TRANSFER INFORMATION -->
                                    <!-- ================================================= -->

                                    <uxap:ObjectPageSubSection
                                        id="transferInformationSubSection"
                                        title="Transfer Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <layout:Grid
                                                defaultSpan="XL4 L4 M6 S12"
                                                hSpacing="1"
                                                vSpacing="1"
                                                width="100%">

                                                <!-- Request Type -->

                                                <ObjectAttribute
                                                    title="Request Type"
                                                    text="{context>/RequestType}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Requested Date -->

                                                <ObjectAttribute
                                                    title="Requested Date"
                                                    text="{context>/RequestedDate}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Site -->

                                                <ObjectAttribute
                                                    title="Relieving Site"
                                                    text="{context>/RelievingSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Site -->

                                                <ObjectAttribute
                                                    title="Required Site"
                                                    text="{context>/RequiredSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Trade -->

                                                <ObjectAttribute
                                                    title="Relieving Trade"
                                                    text="{context>/RelievingTrade}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Trade -->

                                                <ObjectAttribute
                                                    title="Required Trade"
                                                    text="{context>/RequiredTrade}"
                                                    class="sapUiTinyMarginBottom"/>

                                            </layout:Grid>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>


                                    <!-- ================================================= -->
                                    <!-- EMPLOYEE INFORMATION -->
                                    <!-- ================================================= -->

                                    <uxap:ObjectPageSubSection
                                        id="employeeInformationSubSection"
                                        title="Employee Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <layout:Grid
                                                defaultSpan="XL4 L4 M6 S12"
                                                hSpacing="1"
                                                vSpacing="1"
                                                width="100%">

                                                <!-- Employee Name -->

                                                <ObjectAttribute
                                                    title="Employee Name"
                                                    text="{context>/EmployeeName}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Employee ID -->

                                                <ObjectAttribute
                                                    title="Employee ID"
                                                    text="{context>/EmployeeID}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Department -->

                                                <ObjectAttribute
                                                    title="Department"
                                                    text="{context>/Department}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Designation -->

                                                <ObjectAttribute
                                                    title="Designation"
                                                    text="{context>/Designation}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Requested By -->

                                                <ObjectAttribute
                                                    title="Requested By"
                                                    text="{context>/RequestedBy}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Required Site -->

                                                <ObjectAttribute
                                                    title="Required Site"
                                                    text="{context>/RequiredSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Relieving Site -->

                                                <ObjectAttribute
                                                    title="Relieving Site"
                                                    text="{context>/RelievingSite}"
                                                    class="sapUiTinyMarginBottom"/>


                                                <!-- Additional Details -->

                                                <ObjectAttribute
                                                    title="Additional Details"
                                                    text="{context>/AdditionalDetails}"
                                                    class="sapUiTinyMarginBottom"/>

                                            </layout:Grid>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>


                                    <!-- ================================================= -->
                                    <!-- APPROVAL INFORMATION -->
                                    <!-- ================================================= -->

                                    <uxap:ObjectPageSubSection
                                        id="approvalInformationSubSection"
                                        title="Approval Information"
                                        titleUppercase="false">

                                        <uxap:blocks>

                                            <!-- ============================================= -->
                                            <!-- APPROVAL TRAIL CARD -->
                                            <!-- ============================================= -->

                                            <Panel
                                                id="approvalTrailPanel"
                                                headerText="Approval Trail"
                                                width="100%"
                                                class="sapUiResponsiveMargin">

                                                <VBox>

                                                    <!-- L1 - Completed -->

                                                    <VBox
                                                        class="sapUiTinyMarginBottom">

                                                        <ObjectStatus
                                                            icon="sap-icon://message-success"
                                                            text="{approval>/L1ApprovedBy}"
                                                            state="Success"/>

                                                        <Text
                                                            text="L1 - Facility In-charge"
                                                            class="sapUiTinyMarginBegin"/>

                                                        <ObjectStatus
                                                            text="✓ {approval>/L1ApprovedDate}"
                                                            state="Success"
                                                            class="sapUiTinyMarginBegin"/>

                                                    </VBox>


                                                    <!-- L2 - Completed -->

                                                    <VBox
                                                        class="sapUiTinyMarginBottom">

                                                        <ObjectStatus
                                                            icon="sap-icon://message-success"
                                                            text="{approval>/L2ApprovedBy}"
                                                            state="Success"/>

                                                        <Text
                                                            text="L2 - Property Manager"
                                                            class="sapUiTinyMarginBegin"/>

                                                        <ObjectStatus
                                                            text="✓ {approval>/L2ApprovedDate}"
                                                            state="Success"
                                                            class="sapUiTinyMarginBegin"/>

                                                    </VBox>


                                                    <!-- L3 - Completed -->

                                                    <VBox
                                                        class="sapUiTinyMarginBottom">

                                                        <ObjectStatus
                                                            icon="sap-icon://message-success"
                                                            text="{approval>/L3ApprovedBy}"
                                                            state="Success"/>

                                                        <Text
                                                            text="L3 - Regional Head"
                                                            class="sapUiTinyMarginBegin"/>

                                                        <ObjectStatus
                                                            text="✓ {approval>/L3ApprovedDate}"
                                                            state="Success"
                                                            class="sapUiTinyMarginBegin"/>

                                                    </VBox>


                                                    <!-- L4 - Current / Awaiting action -->

                                                    <VBox
                                                        class="sapUiTinyMarginBottom">

                                                        <ObjectStatus
                                                            icon="sap-icon://pending"
                                                            text="{approval>/L4ApprovedBy}"
                                                            state="Information"/>

                                                        <Text
                                                            text="L4 - HR Manager"
                                                            class="sapUiTinyMarginBegin"/>

                                                        <ObjectStatus
                                                            icon="sap-icon://hint"
                                                            text="Awaiting action"
                                                            state="Information"
                                                            class="sapUiTinyMarginBegin"/>

                                                    </VBox>


                                                    <!-- L5 - Pending -->

                                                    <VBox>

                                                        <ObjectStatus
                                                            icon="sap-icon://circle-task-2"
                                                            text="{approval>/L5ApprovedBy}"
                                                            state="None"/>

                                                        <Text
                                                            text="L5 - Chief Executive"
                                                            class="sapUiTinyMarginBegin"/>

                                                        <Text
                                                            text="Pending L4"
                                                            class="sapUiTinyMarginBegin"/>

                                                    </VBox>

                                                </VBox>

                                            </Panel>

                                        </uxap:blocks>

                                    </uxap:ObjectPageSubSection>

                                </uxap:subSections>

                            </uxap:ObjectPageSection>

                        </uxap:sections>

                    </uxap:ObjectPageLayout>

                </content>

            </Page>

        </pages>

    </App>

</mvc:View>